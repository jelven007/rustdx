[Unit]
Description=Rustdx single-host immutable publication controller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rustdx
Group=rustdx
UMask=0077
WorkingDirectory=/var/lib/rustdx
EnvironmentFile=-/etc/rustdx/publisher.env
ExecStart=/usr/bin/python3 /opt/rustdx/scripts/ops/daily.py run --settings /etc/rustdx/daily.json
TimeoutStartSec=32000
TimeoutStopSec=45
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rustdx /var/lib/rustdx-scheduler /var/lib/node_exporter/textfile_collector
ReadOnlyPaths=/srv/rustdx/inputs /srv/rustdx/fact-evidence /srv/rustdx/acceptance /opt/rustdx /etc/rustdx
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
CPUQuota=200%
TasksMax=128
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
