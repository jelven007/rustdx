+/// Independent, bounded readback evidence. It never appends to the publication ledger.
+pub(crate) struct QueryAudit {
+    directory: PathBuf,
+    sequence: Rc<Cell<u64>>,
+    usage: Rc<RefCell<storage::TreeUsage>>,
+    max_bytes: u64,
