+            .unwrap()
+            .collect::<std::result::Result<Vec<_>, _>>()
+            .unwrap();
+        assert!(plans.iter().any(|p| p.contains("jobs_by_created")));
+        assert!(plans.iter().any(|p| p.contains("attempts_by_job")));
+        assert!(!plans.iter().any(|p| p.contains("TEMP B-TREE")));
+        println!(
